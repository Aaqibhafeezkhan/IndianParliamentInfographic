{
  "dataMode": "offline-first",
  "memberData": "user-imported",
  "storage": "browser-local-storage",
  "externalMemberDataRequests": false,
  "localStaticResources": true,
  "officialReferenceSources": {
    "lokSabha": "https://sansad.in/ls/members",
    "rajyaSabha": "https://sansad.in/rs/members"
  },
  "importFormats": [
    "csv",
    "json"
  ],
  "requiredFields": [
    "name",
    "house"
  ],
  "unvalidatedFields": [
    "attendance",
    "questionsAsked",
    "debatesParticipated",
    "billsIntroduced",
    "assetsInCr",
    "liabilitiesInCr",
    "criminalCases"
  ],
  "derivedFields": [
    "counts",
    "shares",
    "rankings",
    "comparisons"
  ],
  "productionRule": "Do not load legacy.html or call Digital Sansad APIs from the production application. Do not bundle official member records without confirmed reuse permission."
}
